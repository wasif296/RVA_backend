NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/lms
CORS_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
LOG_LEVEL=info
SEED_ADMIN_EMAIL=admin@rva.academy
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_BASE_URL=/uploads
STORAGE_DRIVER=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Resend (https://resend.com) — required in production. In development, when
# RESEND_API_KEY is blank, invite/reset emails are logged to the console
# (including the link) instead of sent, so the flow works with no network
# and no Resend account. A send failure is never silent either way — it is
# always reported back as emailSent:false with a reason.
RESEND_API_KEY=
EMAIL_FROM=RVA Academy <no-reply@rva.academy>
# Frontend origin used to build invite/reset links, e.g. https://app.rva.academy
APP_URL=http://localhost:5173
